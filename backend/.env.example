# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your key is never uploaded.

# Free key from https://console.groq.com (starts with gsk_)
GROQ_API_KEY=

# Optional: override Groq model ids (see https://console.groq.com/docs/models)
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: DePlot speed settings (defaults shown). Fewer patches = faster.
# DEPLOT_MAX_PATCHES=2048
# DEPLOT_QUANTIZE=0

# Frontend address allowed to call the API (comma-separated for several)
ALLOWED_ORIGINS=http://localhost:5173
